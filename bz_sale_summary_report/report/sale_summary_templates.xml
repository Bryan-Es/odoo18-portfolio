<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sale_summary_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <t t-set="address">
                <div t-field="doc.partner_id"
                     t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}'/>
            </t>
            <div class="page">
                <h2 class="mt-4">
                    <span>Sales Summary</span>
                    <span t-field="doc.name"/>
                </h2>

                <div class="row mt-4 mb-4">
                    <div class="col-3" t-if="doc.date_order">
                        <strong>Order Date</strong>
                        <p class="m-0" t-field="doc.date_order" t-options='{"widget": "date"}'/>
                    </div>
                    <div class="col-3" t-if="doc.bz_delivery_deadline">
                        <strong>Delivery Deadline</strong>
                        <p class="m-0" t-field="doc.bz_delivery_deadline"/>
                    </div>
                    <div class="col-3" t-if="doc.bz_sale_channel">
                        <strong>Sales Channel</strong>
                        <p class="m-0" t-field="doc.bz_sale_channel"/>
                    </div>
                    <div class="col-3" t-if="doc.user_id">
                        <strong>Salesperson</strong>
                        <p class="m-0" t-field="doc.user_id"/>
                    </div>
                </div>

                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start">Product</th>
                            <th class="text-start">Note</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.order_line" t-as="line">
                            <tr t-if="line.display_type == 'line_section'" class="bg-200 fw-bold">
                                <td colspan="5"><span t-field="line.name"/></td>
                            </tr>
                            <tr t-elif="line.display_type == 'line_note'" class="fst-italic">
                                <td colspan="5"><span t-field="line.name"/></td>
                            </tr>
                            <tr t-else="">
                                <td><span t-field="line.product_id"/></td>
                                <td><span t-field="line.bz_line_note"/></td>
                                <td class="text-end">
                                    <span t-field="line.product_uom_qty"/>
                                    <span t-field="line.product_uom" groups="uom.group_uom"/>
                                </td>
                                <td class="text-end"><span t-field="line.price_unit"/></td>
                                <td class="text-end">
                                    <span t-field="line.price_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr>
                                <td>Total Quantity</td>
                                <td class="text-end"><span t-field="doc.bz_total_qty"/></td>
                            </tr>
                            <tr>
                                <td>Untaxed Amount</td>
                                <td class="text-end">
                                    <span t-field="doc.amount_untaxed"
                                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td>Taxes</td>
                                <td class="text-end">
                                    <span t-field="doc.amount_tax"
                                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr class="fw-bold">
                                <td>Total</td>
                                <td class="text-end">
                                    <span t-field="doc.amount_total"
                                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div t-if="doc.note" class="mt-4">
                    <strong>Terms and Conditions</strong>
                    <div t-field="doc.note"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_sale_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="bz_sale_summary_report.report_sale_summary_document"
                   t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
